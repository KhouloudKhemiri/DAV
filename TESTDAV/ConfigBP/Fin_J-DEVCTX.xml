	   <OnInit>
			    <Requet Tables="CNFTAB" >
					  <Select Nom="CONF" Type="AlphaNumerique" ColTable="CODCNF"/>            
				  </Requet>
								
				<Result>
            if (!%CONF%.equals("0"))
            {
             %THIS% = "ERREUR: Journée non conforme";
             return;
            }
						if(Integer.parseInt(%EtatSystem%)== 1)
						%THIS%="ERREUR: Accée refusé, une procédure est en cours d'execution. ";
						else
						if(Integer.parseInt(%Niveau%) > 2)
						%THIS%="ERREUR: Fin de journée déjà lancée ";
						else if(Integer.parseInt(%Niveau%) != 2)
						{
						%THIS%="ERREUR: Début de journée non effectuée ";
						}
						else
						{
						%THIS01%=%Journee%;
						
						%THIS04%=%URLEtat%+"MQ"+%Journee%.substring(0,2)+"93";
						}						
				</Result>
				
		</OnInit>	
		 <OnUpdate>
				<Result>
					%EtatSystem%=1;
  					%Niveau%=3;
				</Result>	

