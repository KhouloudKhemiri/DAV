            <Procedure Nom="DATESTAT('FIN_J', 'F')" />

				<Result>
				<![CDATA[
					if (%THIS03%.compareTo("")==0 && %THIS08%.compareTo("")==0)
					{
            %THIS%="Confirmation:Fin de journée effectuée avec succès.<br>" ;
		  			%EtatSystem%=0;
					}
					else
					{
            %THIS%="ERREUR: "+%THIS03%+ " "+%THIS08%;
            %EtatSystem%=0;
					}
        ]]>
				</Result>			
        
